<nav aria-label="breadcrumb" class="mb-4">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><%= link_to "Students", students_path %></li>
    <li class="breadcrumb-item active">New Student</li>
  </ol>
</nav>

<div class="row">
  <div class="col-md-8">
    <div class="card">
      <div class="card-header bg-primary text-white">
        <h4 class="mb-0">New Student</h4>
      </div>
      <div class="card-body">
        <%#
          render 'form' loads the _form.html.erb partial
          The 'student: @student' passes the variable to the partial

          Java equivalent: <th:block th:replace="fragments/form :: studentForm">
        %>
        <%= render 'form', student: @student %>
      </div>
    </div>
  </div>

  <div class="col-md-4">
    <div class="card bg-light">
      <div class="card-header">
        <strong>Creating Records</strong>
      </div>
      <div class="card-body">
        <p class="small">
          When you submit this form, Rails will:
        </p>
        <ol class="small">
          <li>Send a POST request to <code>/students</code></li>
          <li>Controller calls <code>Student.new(params)</code></li>
          <li>Validations run on the model</li>
          <li>If valid, <code>student.save</code> executes INSERT</li>
          <li>Redirect to the new student's page</li>
        </ol>
        <p class="small mb-0">
          <strong>SQL executed:</strong><br>
          <code class="small">INSERT INTO students (...) VALUES (...)</code>
        </p>
      </div>
    </div>
  </div>
</div>
