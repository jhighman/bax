<div class="d-flex justify-content-between align-items-center mb-4">
  <h1>Students</h1>
  <div>
    <span class="badge bg-secondary fs-6 me-2"><%= @students.count %> students</span>
    <%= link_to "New Student", new_student_path, class: "btn btn-primary" %>
  </div>
</div>

<p class="lead text-muted mb-4">
  Module 2: Students are now stored in <strong>PostgreSQL</strong>. Data persists across server restarts.
</p>

<div class="table-responsive">
  <table class="table table-striped table-hover">
    <thead class="table-dark">
      <tr>
        <th>Student Number</th>
        <th>Name</th>
        <th>Email</th>
        <th>Major</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <%#
        ERB (Embedded Ruby) uses <% %> for Ruby code and <%= %> to output
        Java equivalent: JSTL <c:forEach items="${students}" var="student">

        Note: @students now comes from the database via Active Record
        The SQL executed: SELECT * FROM students ORDER BY last_name, first_name
      %>
      <% @students.each do |student| %>
        <tr>
          <td><code><%= student.student_number %></code></td>
          <td><%= link_to student.full_name, student_path(student) %></td>
          <td><%= mail_to student.email, student.email if student.email.present? %></td>
          <td><%= student.major %></td>
          <td>
            <div class="btn-group btn-group-sm">
              <%= link_to "View", student_path(student), class: "btn btn-outline-primary" %>
              <%= link_to "Edit", edit_student_path(student), class: "btn btn-outline-secondary" %>
              <%= button_to "Delete", student_path(student), method: :delete,
                  class: "btn btn-outline-danger",
                  data: { turbo_confirm: "Are you sure you want to delete #{student.full_name}?" } %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<% if @students.empty? %>
  <div class="alert alert-info">
    No students yet. <%= link_to "Add the first student", new_student_path %>.
  </div>
<% end %>

<div class="card bg-light mt-4">
  <div class="card-body">
    <h5 class="card-title">Module 2 Notes</h5>
    <ul class="mb-0">
      <li>Students are stored in <strong>PostgreSQL</strong> database</li>
      <li>Data persists when the server restarts</li>
      <li>Full CRUD operations: Create, Read, Update, Delete</li>
      <li>Try the Rails console: <code>bin/rails console</code> then <code>Student.all</code></li>
    </ul>
  </div>
</div>
